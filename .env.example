# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon do Supabase (pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role do Supabase (secreta, só servidor)
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta do servidor com o Postgres (secreta, só servidor). O navegador não fala com o banco.
# Local: o DB_URL do `pnpm supabase status`. Produção: pooler em modo Transaction (porta 6543).
DATABASE_URL=
# Validade, em segundos, do link assinado dos vídeos do bucket (opcional, só servidor, padrão 3600 = 1 h)
VIDEO_URL_VALIDADE_SEGUNDOS=3600
# Chave da API do OpenRouter (secreta, só servidor)
OPENROUTER_API_KEY=
# Modelo do OpenRouter (hoje: deepseek/deepseek-v4.1-flash-1017). Ao trocar, revise PROVEDORES em src/lib/api-auth.ts
OPENROUTER_MODEL=
# Slug do preset do OpenRouter com a voz da especialista (opcional, só o assistente). Sem o "@preset/".
# Com ele, a persona do ai_config deixa de ir no prompt do assistente (o roteiro continua usando).
OPENROUTER_PRESET=
# Chave da Brave Search API (secreta, só servidor): vídeos do TikTok embaixo do roteiro. Vazia = sem vídeos.
BRAVE_API_KEY=
# Webhook de criação de conta (POST /api/webhook/conta). Segredo enviado pela plataforma de venda no
# cabeçalho `Authorization: Bearer <segredo>` (secreto, só servidor). Gere com: openssl rand -base64 32
WEBHOOK_CONTA_SEGREDO=
# Origens que podem chamar o webhook pelo navegador (CORS), separadas por vírgula. Vazio = nenhuma.
WEBHOOK_CONTA_ORIGENS=
# Webhook da Applyfy (POST /api/webhook/applyfy). Token que a Applyfy mostra no cadastro do webhook;
# ela manda dentro do corpo, no campo `token` (secreto, só servidor)
APPLYFY_WEBHOOK_TOKEN=
# Ids dos produtos da Applyfy que liberam o Shop Studio (product.id ou externalId), separados por vírgula.
# Vazio = o webhook recusa tudo (500), para não liberar acesso por compra de outro produto
APPLYFY_PRODUTO_IDS=
# E-mail de acesso depois da compra, pela Resend (resend.com). Chave da API (secreta, só servidor)
RESEND_API_KEY=
# Remetente do e-mail, num domínio verificado na Resend. Ex.: Shop Studio <acesso@seudominio.com>
EMAIL_REMETENTE=
# Endereço público do app, sem barra no fim (vai no link do e-mail: SITE_URL/entrar)
SITE_URL=
