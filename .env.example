# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon do Supabase (pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role do Supabase (secreta, só servidor)
SUPABASE_SERVICE_ROLE_KEY=
# Chave da API do OpenRouter (secreta, só servidor)
OPENROUTER_API_KEY=
# Modelo do OpenRouter usado pela IA (ex.: anthropic/claude-sonnet-4.5)
OPENROUTER_MODEL=
