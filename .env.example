# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anon do Supabase (pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role do Supabase (secreta, só servidor)
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta do servidor com o Postgres (secreta, só servidor). O navegador não fala com o banco.
# Local: o DB_URL do `pnpm supabase status`. Produção: pooler em modo Transaction (porta 6543).
DATABASE_URL=
# Validade, em segundos, do link assinado dos vídeos do bucket (opcional, só servidor, padrão 3600 = 1 h)
VIDEO_URL_VALIDADE_SEGUNDOS=3600
# Chave da API do OpenRouter (secreta, só servidor)
OPENROUTER_API_KEY=
# Modelo do OpenRouter (hoje: deepseek/deepseek-v4.1-flash-1017). Ao trocar, revise PROVEDORES em src/lib/api-auth.ts
OPENROUTER_MODEL=
# Login com Google no Supabase LOCAL (lidas pelo supabase/config.toml via `pnpm db:start`).
# Em produção, cole os mesmos valores no painel do Supabase: Auth → Providers → Google.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
